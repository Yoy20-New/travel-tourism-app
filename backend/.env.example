# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
MONGODB_URI="mongodb://localhost:27017/tourify"
# DATABASE_URL="postgresql://username:password@localhost:5432/travel_tourism_db"  # optional; not used with MongoDB
# Use an in-memory MongoDB (dev only). Set to true to avoid installing Mongo locally.
IN_MEMORY_MONGO=false
JWT_SECRET=your_super_secure_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Email Configuration (SendGrid)
EMAIL_FROM=noreply@travelculture.com
EMAIL_FROM_NAME="TravelCulture"
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Alternative Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# OTP Configuration
OTP_EXPIRES_IN=10
OTP_LENGTH=6

# File Upload Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Configuration (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Security Configuration
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# External APIs
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Admin Configuration
ADMIN_EMAIL=admin@travelculture.com
ADMIN_PASSWORD=secure_admin_password_here

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Cache Configuration (Redis - Optional)
REDIS_URL=redis://localhost:6379
